# API 키 저장 템플릿 — 실제 값은 secrets/.env 에 넣을 것 (그 파일은 .gitignore로 저장소에 절대 안 올라감)
# 사용법: 이 파일을 secrets/.env 로 복사한 뒤 실제 키 값을 채운다.
#   cp secrets/.env.example secrets/.env

# Pexels 무료 스톡사진 API — https://www.pexels.com/api/ 에서 가입 즉시 발급 (무료, 월 20,000회)
PEXELS_API_KEY=

# Unsplash API (선택) — https://unsplash.com/developers 데모앱은 시간당 50회 제한
UNSPLASH_ACCESS_KEY=

# Canva (선택, MCP 커넥터로 연결시엔 별도 키 불필요 — claude.ai 커넥터 설정에서 OAuth로 처리됨)
