# === Claude API (조항 분해/분석용) ===
ANTHROPIC_API_KEY=

# === 국가법령정보 공동활용 API (law.go.kr) ===
# 신청: https://open.law.go.kr (이메일 인증 후 OC 코드 발급)
LAW_GO_KR_OC=

# === Naver Clova OCR ===
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=

# === (선택) Naver Search API ===
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# === 카카오 로컬 API (주변환경 조사 - 편의시설/혐오시설) ===
# 신청: https://developers.kakao.com (REST API 키, 무료)
KAKAO_REST_API_KEY=

# === NEIS 교육정보 개방포털 (학군조사 - 객관적 학교 정보만) ===
# 신청: https://open.neis.go.kr
NEIS_API_KEY=

# === 국토교통부 실거래가 공개시스템 (인근 시세비교) ===
# 신청: data.go.kr에서 "아파트매매 실거래자료" 검색
MOLIT_API_KEY=

# === 국토교통부 건축HUB 건축물대장정보 (공고문 표기 vs 실제 대장 대조) ===
# 신청: data.go.kr에서 "건축HUB 건축물대장정보" 검색
BLDRGST_API_KEY=

# ⚠ 2026-08-07: 이 파일에 실제 키 값이 커밋되어 있던 것을 발견해 전부 제거함(보안사고).
# 실키는 반드시 secrets/.env (gitignore 처리됨)에만 넣을 것 — 이 파일은 저장소에 커밋되는
# "형식 예시"이므로 값이 채워지면 안 된다. secrets/README.md 참고.
